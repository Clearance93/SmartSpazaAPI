{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SmartSpazaAPI",
    "Audience": "SmartSpazaAPI",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RequireEmailConfirmation": true
  },
  "Https": {
    "RequireHttps": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SmartSpaza"
  },
  "AppSettings": {
    "EmailConfirmationUrl": "",
    "PasswordResetUrl": ""
  }
}
